# macOS
.DS_Store

# Quarto: salida generada y cachés de proyecto
/_site/
/.quarto/

# Caché de ejecución de Jupyter (se regenera; 20 MB)
/.jupyter_cache/

# Notebooks intermedios que Quarto deja al interrumpir un render
lab*.quarto_ipynb*

# LaTeX
*.aux
*.log
*.out
*.toc

**/*.quarto_ipynb

# SVG generados por tikz.lua a partir de los bloques {.tikz}, en cualquier carpeta
**/_tikz/

# Figuras intermedias que Quarto genera al renderizar cada lab a PDF
/lab*_files/

# Ficheros intermedios de Quarto en cualquier carpeta
**/*_files/
